# ---------------------------------------------------------------------------
# relate [R] environment. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
POSTGRES_PASSWORD=relate_secure_password
# Only needed when running the API outside docker compose:
# DATABASE_URL=postgresql+asyncpg://relate_user:relate_secure_password@localhost:5432/relate_crm
# REDIS_URL=redis://localhost:6379/0
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Load demo accounts/deals on first start (marcus@relate.demo / relate123)
SEED_DEMO_DATA=true

# --- Intelligence layer -----------------------------------------------------
# LLM_PROVIDER: ollama | aws_bedrock | anthropic | heuristic
#   Any provider failure falls back to the deterministic 'heuristic' engine.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Claude inside your AWS account (Bedrock). Uses the standard AWS credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Claude API (only if LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

LLM_TIMEOUT_SECONDS=60

# EMBEDDING_PROVIDER: hash (offline) | ollama | aws_bedrock
# Changing it later requires re-embedding existing activities.
EMBEDDING_PROVIDER=hash

# Background jobs via Celery/Redis (docker compose sets this for the api service)
USE_CELERY=false

# --- Web links, files & privacy ---------------------------------------------
# Public URL of the web app (used in e-signature links sent to customers)
PUBLIC_WEB_URL=http://localhost:3000
# Long random secret used to encrypt mailbox credentials at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, it falls back to JWT_SECRET (fine for demos, not production).
# Contact PII in the audit log uses separate per-contact keys stored in the database,
# which are destroyed on erasure (crypto-shredding).
# DATA_ENCRYPTION_KEY=
MAX_UPLOAD_MB=25
# STORAGE_DIR=./storage          (compose uses the relate_files volume)

# --- Voice (Quick-Log) --------------------------------------------------------
# TRANSCRIPTION_PROVIDER: disabled | whisper_asr (compose "voice" profile) | faster_whisper (in-process)
TRANSCRIPTION_PROVIDER=disabled
WHISPER_MODEL=base
# WHISPER_ENDPOINT=http://localhost:9000

# --- ERP fabric -----------------------------------------------------------------
# ERP_CONNECTOR: demo | file (CSV drop folder) | rest | disabled
ERP_CONNECTOR=demo
# ERP_EXCHANGE_DIR=./erp-exchange
# ERP_REST_URL=https://erp.internal/api
# ERP_REST_TOKEN=

# Webhook targets for SDC ecosystem modules (JSON map). Leave {} for zero egress;
# modules can instead poll GET /api/v1/integrations/events.
ECOSYSTEM_WEBHOOKS={}
# e.g. ECOSYSTEM_WEBHOOKS={"promo":"https://promo.internal/hooks/crm","yield":"https://yield.internal/hooks/crm"}
