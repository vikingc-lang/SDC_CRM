# ---------------------------------------------------------------------------
# Cirra environment. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
POSTGRES_PASSWORD=cirra_secure_password
# Only needed when running the API outside docker compose:
# DATABASE_URL=postgresql+asyncpg://cirra_user:cirra_secure_password@localhost:5432/cirra_crm
# REDIS_URL=redis://localhost:6379/0
# Signs sign-in tokens. Leave empty to have a random one generated on first start (kept on the data volume),
# or set a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside ENVIRONMENT=development the API refuses to start with a missing, short or published secret.
JWT_SECRET=
# ENVIRONMENT=production
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Load demo accounts/deals on first start (marcus@cirra.demo / cirra123)
SEED_DEMO_DATA=true

# --- Intelligence layer -----------------------------------------------------
# LLM_PROVIDER: ollama | aws_bedrock | anthropic | heuristic
#   Any provider failure falls back to the deterministic 'heuristic' engine.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Claude inside your AWS account (Bedrock). Uses the standard AWS credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Claude API (only if LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

LLM_TIMEOUT_SECONDS=60

# EMBEDDING_PROVIDER: hash (offline) | ollama | aws_bedrock
# Changing it later requires re-embedding existing activities.
EMBEDDING_PROVIDER=hash

# Background jobs via Celery/Redis (docker compose sets this for the api service)
USE_CELERY=false

# --- Web links, files & privacy ---------------------------------------------
# Public URL of the web app (used in e-signature links sent to customers)
PUBLIC_WEB_URL=http://localhost:3000
# Long random secret used to encrypt mailbox credentials at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generated on first start together with JWT_SECRET when both are empty; otherwise it falls back to JWT_SECRET.
# Contact PII in the audit log uses separate per-contact keys stored in the database,
# which are destroyed on erasure (crypto-shredding).
# DATA_ENCRYPTION_KEY=
MAX_UPLOAD_MB=25
# STORAGE_DIR=./storage          (compose uses the cirra_files volume)

# --- Voice (Quick-Log) --------------------------------------------------------
# TRANSCRIPTION_PROVIDER: disabled | whisper_asr (compose "voice" profile) | faster_whisper (in-process)
TRANSCRIPTION_PROVIDER=disabled
WHISPER_MODEL=base
# WHISPER_ENDPOINT=http://localhost:9000

# --- ERP fabric -----------------------------------------------------------------
# ERP_CONNECTOR: demo | file (JSON drop folder: inbound/customers.json, inbound/invoices.json) | rest | disabled
ERP_CONNECTOR=demo
# ERP_EXCHANGE_DIR=./erp-exchange
# ERP_REST_URL=https://erp.internal/api
# ERP_REST_TOKEN=
# Sales orders: demo acks instantly; file writes outbound/sales-order-<no>.json and reads inbound/order-acks.json;
# rest POSTs {ERP_REST_URL}/sales-orders

# --- Lead enrichment ------------------------------------------------------------
# ENRICHMENT_PROVIDER: internal (existing accounts + peer leads) | rest | disabled
ENRICHMENT_PROVIDER=internal
# ENRICHMENT_REST_URL=https://enrichment.internal/api/lookup
# ENRICHMENT_REST_TOKEN=

# --- E-signature ------------------------------------------------------------------
# ESIGN_PROVIDER: builtin | docusign | adobe_sign (default for new sends; can be chosen per document)
ESIGN_PROVIDER=builtin
# ESIGN_API_URL=https://demo.docusign.net/restapi/v2.1/accounts/<account-id>
# ESIGN_API_TOKEN=
# Shared secret the provider's completion webhook sends in X-Cirra-Esign-Secret
# ESIGN_WEBHOOK_SECRET=

# --- System email (scheduled report deliveries) --------------------------------------
# Without SMTP_HOST, subscribed reports arrive as in-app notifications only.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=cirra@yourcompany.com
# SMTP_PASSWORD=
# SMTP_FROM=cirra@yourcompany.com
# SMTP_STARTTLS=true

# --- Operations --------------------------------------------------------------------
# API rate limits per minute (counted in Redis across replicas); set RATE_LIMIT_ENABLED=false to switch off.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=600            # a signed-in user
# RATE_LIMIT_API_KEY_PER_MINUTE=300    # an API key
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=120  # unauthenticated API calls, per IP
# RATE_LIMIT_LOGIN_PER_MINUTE=60       # sign-in and two-factor attempts, per IP
# RATE_LIMIT_PUBLIC_PER_MINUTE=120     # public forms, e-signature, CSAT, unsubscribe, inbound email, per IP
# RATE_LIMIT_TRACKING_PER_MINUTE=1200  # email open pixels and click-throughs, per IP
# text (default) or json: one JSON object per log line, with the request id
# LOG_FORMAT=text

# --- Email-to-case and email tracking -------------------------------------------------
# Public URL of this API: email open/click tracking links point here.
PUBLIC_API_URL=http://localhost:8000
# Shared secret your mail provider's inbound webhook sends in X-Cirra-Inbound-Secret to
# POST /api/v1/inbound/email (unset = endpoint disabled). Or poll a support mailbox over IMAP:
# INBOUND_EMAIL_SECRET=
# SUPPORT_IMAP_HOST=outlook.office365.com
# SUPPORT_IMAP_PORT=993
# SUPPORT_IMAP_USER=support@yourcompany.com
# SUPPORT_IMAP_PASSWORD=

# Webhook targets for SDC ecosystem modules (JSON map). Leave {} for zero egress;
# modules can instead poll GET /api/v1/integrations/events.
ECOSYSTEM_WEBHOOKS={}
# e.g. ECOSYSTEM_WEBHOOKS={"promo":"https://promo.internal/hooks/crm","yield":"https://yield.internal/hooks/crm"}
